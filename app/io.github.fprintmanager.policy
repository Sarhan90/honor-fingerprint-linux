<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="io.github.fprintmanager.helper">
    <description>Configure the fingerprint reader</description>
    <description xml:lang="ru">Настройка сканера отпечатков</description>
    <message>Authentication is required to configure the fingerprint reader</message>
    <message xml:lang="ru">Для настройки сканера отпечатков нужны права администратора</message>
    <icon_name>auth-fingerprint-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/fprint-manager-helper</annotate>
  </action>
</policyconfig>
